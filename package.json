    "csv-parse": "^5.0.0",
    "csv-stringify": "^6.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.0",
    "ulid": "^2.3.0",
